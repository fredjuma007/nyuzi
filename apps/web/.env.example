# Better Auth Configuration
BETTER_AUTH_SECRET=nyuzi-editorial-auth-secret-key-32-chars-long-development
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration (Defaults to zero-config local SQLite file)
DATABASE_URL=file:./nyuzi.db
# DATABASE_AUTH_TOKEN= (Optional for Turso cloud)

# Social OAuth Providers (Optional - Email/password works out of the box)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
