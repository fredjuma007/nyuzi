{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyuzi-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyuzi-db",
      "database_id": "local-nyuzi-db",
      "migrations_dir": "migrations"
    }
  ]
}