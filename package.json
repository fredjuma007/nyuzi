{
  "name": "nyuzi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nyuzi/web",
    "dev:api": "npm run dev -w @nyuzi/api",
    "dev:widget": "npm run dev -w @nyuzi/widget",
    "build:widget": "npm run build -w @nyuzi/widget",
    "build:web": "npm run build -w @nyuzi/web",
    "build": "npm run build:widget && npm run build:web"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}
